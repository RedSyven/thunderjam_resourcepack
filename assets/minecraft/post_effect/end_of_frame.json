{
    "targets": {
        "swap": {},
        "data": {
            "width": 1,
            "height": 1,
            "persistent": true
        },
        "data_swap": {
            "width": 1,
            "height": 1
        }
    },
    "passes": [
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "minecraft:post/data_copy",
            "inputs": [
                { "sampler_name": "In", "target": "data" }
            ],
            "output": "data_swap"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "minecraft:post/data_write",
            "inputs": [
                { "sampler_name": "PrevData", "target": "data_swap" },
                { "sampler_name": "Main", "target": "minecraft:main" }
            ],
            "output": "data"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "minecraft:post/effects",
            "inputs": [
                { "sampler_name": "In", "target": "minecraft:main" },
                { "sampler_name": "Data", "target": "data" }
            ],
            "output": "swap"
        },
        {
            "vertex_shader": "minecraft:core/screenquad",
            "fragment_shader": "minecraft:post/blit",
            "inputs": [
                { "sampler_name": "In", "target": "swap" }
            ],
            "uniforms": {
                "BlitConfig": [
                    { "name": "ColorModulate", "type": "vec4", "value": [1.0, 1.0, 1.0, 1.0] }
                ]
            },
            "output": "minecraft:main"
        }
    ]
}